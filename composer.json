{
    "name": "fab2s/enumerate",
    "description": "Enumerate, a nice boost to your enums",
    "type": "library",
    "authors": [{
        "name": "Fabrice de Stefanis"
    }],
    "homepage": "https://github.com/fab2s/Enumerate",
    "support": {
        "issues": "https://github.com/fab2s/Enumerate/issues",
        "source": "https://github.com/fab2s/Enumerate"
    },
    "keywords": [
        "Enum",
        "PHP"
    ],
    "license": [
        "MIT"
    ],
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0|^12.0|^13.0",
        "laravel/pint": "^1.21.2"
    },
    "autoload": {
        "psr-4": {
            "fab2s\\Enumerate\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "fab2s\\Enumerate\\Tests\\": "tests"
        }
    },
    "scripts": {
        "post-update-cmd": [
            "rm -rf .*.cache"
        ],
        "post-install-cmd": [
            "rm -rf .*.cache"
        ],
        "fix": [
            "Composer\\Config::disableProcessTimeout",
            "@php vendor/bin/pint --ansi --config pint.json --"
        ],
        "test": [
            "Composer\\Config::disableProcessTimeout",
            "@php vendor/bin/phpunit --colors --"
        ],
        "cov": [
            "Composer\\Config::disableProcessTimeout",
            "@php vendor/bin/phpunit --colors --coverage-html ./cov --"
        ]
    }
}
